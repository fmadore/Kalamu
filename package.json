{
	"name": "kalamu",
	"version": "0.4.0",
	"description": "Read scanned and handwritten documents, transcribe interviews and analyse texts with the AI provider of your choice, or offline",
	"license": "MIT",
	"author": "Frédérick Madore",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fmadore/Kalamu.git"
	},
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.13.0 || ^24.0.0"
	},
	"scripts": {
		"dev": "vite dev",
		"prepare": "svelte-kit sync || echo ''",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"tauri": "tauri",
		"fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource-variable/source-serif-4": "^5.3.1",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@lucide/svelte": "^1.61.0",
		"@tauri-apps/api": "^2.12.4",
		"@tauri-apps/plugin-dialog": "^2.8.3",
		"@tauri-apps/plugin-notification": "^2.7.0",
		"@tauri-apps/plugin-opener": "^2.7.2",
		"pdfjs-dist": "^6.4.299"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
