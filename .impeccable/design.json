  "components": [
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default action: white ground, strong hairline, sans label.",
      "html": "<button class=\"ds-btn\">Export…</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;gap:var(--space-2);min-height:var(--control-md);padding:0 var(--space-4);border:1px solid var(--line-strong);border-radius:var(--radius-control);background:var(--surface-2);color:var(--text-body);font-family:var(--font-ui);font-weight:600;cursor:pointer;transition:background-color 120ms ease-out,border-color 120ms ease-out}.ds-btn:hover{border-color:var(--line-hover)}.ds-btn:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action on a surface, in bookcloth.",
      "html": "<button class=\"ds-btn-primary\">Start</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;min-height:var(--control-md);padding:0 var(--space-4);border:1px solid var(--accent);border-radius:var(--radius-control);background:var(--accent);color:var(--on-accent);font-family:var(--font-ui);font-weight:600;cursor:pointer;transition:background-color 120ms ease-out,border-color 120ms ease-out}.ds-btn-primary:hover{background:var(--accent-soft);border-color:var(--accent-soft)}.ds-btn-primary:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Low-emphasis action; takes the bookcloth wash on hover.",
      "html": "<button class=\"ds-btn-ghost\">Cancel</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;min-height:var(--control-md);padding:0 var(--space-4);border:1px solid transparent;border-radius:var(--radius-control);background:transparent;color:var(--text-body);font-family:var(--font-ui);font-weight:600;cursor:pointer;transition:background-color 120ms ease-out}.ds-btn-ghost:hover{background:var(--accent-wash)}.ds-btn-ghost:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Labelled field: label above in the sans, white ground, strong hairline.",
      "html": "<label class=\"ds-field\"><span>Job name</span><input class=\"ds-input\" type=\"text\" value=\"Bulletin 1957\"></label>",
      "css": ".ds-field{display:grid;gap:var(--space-1);font-family:var(--font-ui);}.ds-field>span{font-size:var(--type-sm);font-weight:600;color:var(--text-secondary)}.ds-input{min-height:var(--control-md);padding:var(--space-1) var(--space-3);border:1px solid var(--line-strong);border-radius:var(--radius-control);background:var(--surface-2);color:var(--text-body);font:inherit}.ds-input:hover{border-color:var(--line-hover)}.ds-input:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Outlined status tag, never filled. The corrected variant is rubric.",
      "html": "<span class=\"ds-chip\">Reviewed</span> <span class=\"ds-chip ds-chip-corr\">Corrected</span>",
      "css": ".ds-chip{display:inline-flex;align-items:center;padding:0 var(--space-2);border:1px solid var(--accent-border);border-radius:4px;color:var(--accent);font-family:var(--font-ui);font-size:var(--type-xs);font-weight:600;line-height:1.5}.ds-chip-corr{border-color:var(--rubric);color:var(--rubric)}"
    },
    {
      "name": "Section",
      "kind": "card",
      "refersTo": "",
      "description": "A section opened by the black rule, never boxed.",
      "html": "<section class=\"ds-section\"><h2>Languages</h2><p>French, Arabic</p></section>",
      "css": ".ds-section{border-top:1px solid var(--rule);padding-top:var(--space-4);display:grid;gap:var(--space-3);background:transparent;font-family:var(--font-ui);color:var(--text-body)}.ds-section h2{margin:0;font-family:var(--font-text);font-weight:500;font-size:1.375rem;color:var(--text-bright)}.ds-section p{margin:0}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "rail",
      "description": "Bookcloth rail with a Garamond wordmark as tall as the masthead.",
      "html": "<nav class=\"ds-rail\"><div class=\"ds-wordmark\">Scriptorium</div><a class=\"ds-nav\" href=\"#\">New job</a><a class=\"ds-nav ds-nav-on\" href=\"#\">Jobs <b>1</b></a><a class=\"ds-nav\" href=\"#\">Prompts</a><a class=\"ds-nav\" href=\"#\">Settings</a></nav>",
      "css": ".ds-rail{width:14.5rem;background:var(--shell);color:var(--on-shell);display:grid;gap:2px;padding-bottom:var(--space-4);font-family:var(--font-ui);}.ds-wordmark{height:var(--masthead-height);display:flex;align-items:flex-end;padding:0 var(--space-5) var(--space-4);border-bottom:1px solid var(--shell-line);margin-bottom:var(--space-3);font-family:var(--font-text);font-size:1.875rem;font-weight:500;line-height:1}.ds-nav{display:flex;align-items:center;min-height:2.5rem;margin:0 var(--space-3);padding:0 var(--space-3);border-radius:var(--radius-control);color:var(--on-shell-muted);text-decoration:none;font-size:1rem;transition:background-color 120ms ease-out}.ds-nav:hover{background:var(--shell-2);color:var(--on-shell)}.ds-nav:focus-visible{outline:2px solid var(--on-shell);outline-offset:2px}.ds-nav-on{background:var(--shell-2);color:var(--on-shell);font-weight:600}.ds-nav b{margin-left:auto;min-width:1.375rem;border-radius:999px;background:var(--on-shell);color:var(--shell);font-size:var(--type-xs);text-align:center;line-height:1.25rem}"
