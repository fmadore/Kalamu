{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: everything the app can do.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-progress-bar",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    "notification:default",
    "allow-app-info",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-catalog",
    "allow-refresh-catalog",
    "allow-task-rules",
    "allow-key-status",
    "allow-set-api-key",
    "allow-clear-api-key",
    "allow-test-api-key",
    "allow-offline-status",
    "allow-download-model",
    "allow-cancel-model-download",
    "allow-remove-model",
    "allow-list-presets",
    "allow-save-preset",
    "allow-delete-preset",
    "allow-duplicate-preset",
    "allow-export-presets",
    "allow-import-presets",
    "allow-list-pipelines",
    "allow-save-pipeline",
    "allow-delete-pipeline",
    "allow-export-pipeline",
    "allow-import-pipeline",
    "allow-expand-paths",
    "allow-inspect-files",
    "allow-inspect-links",
    "allow-estimate-cost",
    "allow-create-job",
    "allow-start-job",
    "allow-pause-job",
    "allow-cancel-job",
    "allow-retry-failed",
    "allow-delete-job",
    "allow-list-jobs",
    "allow-get-job",
    "allow-job-pieces",
    "allow-job-text-outputs",
    "allow-job-outputs",
    "allow-open-output",
    "allow-rename-job",
    "allow-source-pieces",
    "allow-piece-preview",
    "allow-piece-audio",
    "allow-source-text",
    "allow-save-correction",
    "allow-save-speaker-names",
    "allow-export-source",
    "allow-compare-source",
    "allow-job-scores",
    "allow-diff-texts",
    "allow-list-projects",
    "allow-create-project",
    "allow-update-project",
    "allow-archive-project",
    "allow-delete-project",
    "allow-project-view",
    "allow-create-collection",
    "allow-rename-collection",
    "allow-delete-collection",
    "allow-add-documents",
    "allow-rename-document",
    "allow-delete-documents",
    "allow-add-to-collection",
    "allow-remove-from-collection",
    "allow-merge-documents",
    "allow-document-detail",
    "allow-set-preferred",
    "allow-attach-plan",
    "allow-attach-job",
    "allow-link-job",
    "allow-detach-job",
    "allow-set-taskbar-progress",
    "allow-set-tray-state",
    "allow-hide-window",
    "allow-quit-app"
  ]
}
