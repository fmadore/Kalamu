{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: everything the app can do.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-theme",
    "core:window:allow-set-progress-bar",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-reveal-item-in-dir",
    "opener:allow-open-url",
    "notification:default",
    "allow-app-info",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-catalog",
    "allow-refresh-catalog",
    "allow-key-status",
    "allow-set-api-key",
    "allow-clear-api-key",
    "allow-test-api-key",
    "allow-list-presets",
    "allow-save-preset",
    "allow-delete-preset",
    "allow-duplicate-preset",
    "allow-export-presets",
    "allow-import-presets",
    "allow-expand-paths",
    "allow-inspect-files",
    "allow-estimate-cost",
    "allow-create-job",
    "allow-start-job",
    "allow-pause-job",
    "allow-cancel-job",
    "allow-retry-failed",
    "allow-delete-job",
    "allow-list-jobs",
    "allow-get-job",
    "allow-job-pieces",
    "allow-source-pieces",
    "allow-piece-preview",
    "allow-save-correction",
    "allow-export-source",
    "allow-compare-source",
    "allow-diff-texts",
    "allow-set-taskbar-progress",
    "allow-quit-app"
  ]
}
